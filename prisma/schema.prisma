generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  GUEST
}

model User {
  id           String   @id @default(uuid())
  name         String
  role         Role     @default(GUEST)
  loginId      String?  @unique
  passwordHash String?
  phone        String?
  company      String?
  department   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedProperties Property[] @relation("PropertyStaff")

  @@index([role, isActive])
}

model Property {
  id          String   @id @default(uuid())
  name        String   @unique
  region      String?
  isActive    Boolean  @default(true)
  staffUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff User? @relation("PropertyStaff", fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([staffUserId])
}
